TELEGRAM_BOT_TOKEN=123456789:replace-with-real-token
MAX_DOWNLOAD_SIZE_MB=200
DOWNLOAD_DIR=/tmp/telegram-social-bot

# HTTP Client timeouts (in seconds)
# HTTP_CONNECT_TIMEOUT=20.0
# HTTP_READ_TIMEOUT=20.0
# HTTP_WRITE_TIMEOUT=20.0
# HTTP_POOL_TIMEOUT=20.0
# HTTP_MEDIA_WRITE_TIMEOUT=180.0


# Optional configuration for platform authentication/bypassing blocks
# COOKIES_FILE_PATH=/path/to/cookies.txt   # Defaults to checking for 'cookies.txt' in the project root if left empty

# Generic Fallback credentials for extractors
# EXTRACTOR_USERNAME=your_username
# EXTRACTOR_PASSWORD=your_password

# Platform-specific credentials
# INSTAGRAM_USERNAME=your_instagram_username
# INSTAGRAM_PASSWORD=your_instagram_password
# YOUTUBE_USERNAME=your_youtube_username
# YOUTUBE_PASSWORD=your_youtube_password
# TWITTER_USERNAME=your_twitter_username
# TWITTER_PASSWORD=your_twitter_password
# TIKTOK_USERNAME=your_tiktok_username
# TIKTOK_PASSWORD=your_tiktok_password


